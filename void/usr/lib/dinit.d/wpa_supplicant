# dhcpcd's shape (Chimera has no wpa_supplicant service) running Void's run script,
# which reads OPTS from conf, else finds interfaces through its auto file

type = process
command = /etc/sv/wpa_supplicant/run
working-dir = /etc/sv/wpa_supplicant
logfile = /var/log/wpa_supplicant.log
before: network.target
depends-on: pre-network.target
