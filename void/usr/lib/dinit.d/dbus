# Chimera's, without --dinit (Void's dbus lacks it); /run/dbus is in tmpfiles.d/dbus.conf

type = process
command = /usr/bin/dbus-daemon --system --nofork --nopidfile --print-address=4
ready-notification = pipefd:4
working-dir = /
before: login.target
depends-on: local.target
load-options: export-passwd-vars
