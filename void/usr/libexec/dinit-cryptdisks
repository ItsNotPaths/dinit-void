#!/bin/sh
# dinit-chimera's crypttab helper: $1 is "early" or "remaining", $2 is "start" or "stop".
# Chimera's, from cports main/cryptsetup-scripts/files.

[ -r /usr/lib/cryptsetup/cryptdisks-functions ] || exit 0
[ -r /etc/crypttab ] || exit 0

. /usr/lib/cryptsetup/cryptdisks-functions

INITSTATE="$1"

case "$2" in
    start) do_start ;;
    stop) do_stop ;;
    *) exit 1 ;;
esac
